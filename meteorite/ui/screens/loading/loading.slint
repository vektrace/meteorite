import { Bg } from "../../components/bg.slint";
import { Icon } from "../../components/icon.slint";
import { Spinner } from "../../components/spinner.slint";
import { Button } from "../../components/button.slint";

export struct LoadingData {
    error: string,
}

export component Loading inherits Rectangle {
    in-out property <LoadingData> data;
    callback retry;

    Bg {
        VerticalLayout {
            padding: 48px;
            spacing: 5px;
            cross-axis-alignment: center;
            Icon {
                width: 256px;
                height: 256px;
                border-radius: 16px;
            }

            if data.error == "": Spinner {
                size: 128px;
                bg: #27272a;
                fg: #1e40af;
            }

            if data.error != "": VerticalLayout {
                padding-top: 48px;
                spacing: 48px;
                cross-axis-alignment: center;

                Rectangle {
                    width: label-error.preferred-width + 40px;
                    height: label-error.preferred-height + 20px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #f87171;
                    background: #dc2626;

                    label-error := Text {
                        text: data.error;
                        wrap: word-wrap;
                    }
                }

                Button {
                    width: root.width / 5;
                    height: 40px;
                    border-radius: 10px;
                    base-color: #e7000b;
                    hover-color: #fb2c36;
                    enabled: true;
                    text: "test";
                    text-color: white;

                    clicked => {
                        retry();
                    }
                }
            }
        }
    }
}