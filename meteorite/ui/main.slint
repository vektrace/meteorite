import { Main } from "screens/main/main.slint";
import { Loading, LoadingData } from "screens/loading/loading.slint";
import { Login } from "screens/login/login.slint";

export enum Screen {
    main,
    loading,
    login,
}

export component App inherits Window {
    maximized: true;
    icon: @image-url("../assets/icon/icon-rounded.png");
    title: "meteorite";

    in property <Screen> screen: Screen.loading;

    in-out property <LoadingData> loading-data;

    callback loading-retry;

    if root.screen == Screen.loading: Loading {
        data: root.loading-data;
        retry => loading-retry();
    }
    if root.screen == Screen.main: Main {}
    if root.screen == Screen.login: Login {}
}